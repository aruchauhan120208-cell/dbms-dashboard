# ---------------------------------------------------------------------------
# Rajasthan Heatwave Monitoring Database System — environment configuration
# Copy this file to `.env` and fill in values as needed.
# ---------------------------------------------------------------------------

# OpenWeather API key — used ONLY by the backend (app/api/weather).
# Get a free key at https://openweathermap.org/api
# If this is missing, the Live Weather page shows a configuration message
# instead of crashing; the rest of the app works without it.
OPENWEATHER_API_KEY=

# Path to the SQLite database file (relative to the project root).
# Defaults to db/heatwave.sqlite when unset.
HEATWAVE_DB_PATH=db/heatwave.sqlite

# Heatwave threshold in Kelvin. Defaults to 316.32788 K (43.18 °C), the value
# at which the dataset's own HEATWAVE flag flips (max flag=0 is 316.3274 K,
# min flag=1 is 316.32788 K). Change only if you change the dataset.
HEATWAVE_THRESHOLD_K=316.32788
